NODE_ENV=development
PORT=8080

# Mail Configuration (for Nodemailer)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=noreply@canopyshield.com
# MAIL_USER=your-email@gmail.com
# MAIL_PASSWORD=your-app-specific-password

# Web Push Configuration
VAPID_SUBJECT=mailto:admin@canopyshield.io
# Replace with generated VAPID keys from scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Development
CANPS_DEV_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canopyshield_dev
CANPS_DEV_REDIS_URL=redis://localhost:6379/0
CANPS_DEV_JWT_ACCESS_SECRET=dev-access-secret-min-16-chars-long
CANPS_DEV_JWT_REFRESH_SECRET=dev-refresh-secret-min-16-chars-long
CANPS_DEV_OPENWEATHERMAP_API_KEY=your-dev-api-key-here
CANPS_DEV_VAPID_SUBJECT=mailto:admin@canopyshield.io
CANPS_DEV_VAPID_PUBLIC_KEY=
CANPS_DEV_VAPID_PRIVATE_KEY=
CANPS_DEV_LOG_LEVEL=debug
CANPS_DEV_PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
CANPS_DEV_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
CANPS_DEV_TREE_PRICE=5000

# Test
CANPS_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canopyshield_test
CANPS_TEST_REDIS_URL=redis://localhost:6379/1
CANPS_TEST_JWT_ACCESS_SECRET=test-access-secret-min-16-chars-long
CANPS_TEST_JWT_REFRESH_SECRET=test-refresh-secret-min-16-chars-long
CANPS_TEST_OPENWEATHERMAP_API_KEY=your-test-api-key-here
CANPS_TEST_VAPID_SUBJECT=mailto:admin@canopyshield.io
CANPS_TEST_VAPID_PUBLIC_KEY=
CANPS_TEST_VAPID_PRIVATE_KEY=
CANPS_TEST_LOG_LEVEL=silent
CANPS_TEST_PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
CANPS_TEST_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
CANPS_TEST_TREE_PRICE=5000

# Staging
CANPS_STAGING_DATABASE_URL=postgresql://postgres:postgres@staging-db:5432/canopyshield_staging
CANPS_STAGING_REDIS_URL=redis://staging-redis:6379/0
CANPS_STAGING_JWT_ACCESS_SECRET=staging-access-secret-min-16-chars-long
CANPS_STAGING_JWT_REFRESH_SECRET=staging-refresh-secret-min-16-chars-long
CANPS_STAGING_OPENWEATHERMAP_API_KEY=your-staging-api-key-here
CANPS_STAGING_VAPID_SUBJECT=mailto:admin@canopyshield.io
CANPS_STAGING_VAPID_PUBLIC_KEY=
CANPS_STAGING_VAPID_PRIVATE_KEY=
CANPS_STAGING_LOG_LEVEL=info
CANPS_STAGING_PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
CANPS_STAGING_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
CANPS_STAGING_TREE_PRICE=5000

# Production
CANPS_PRODUCTION_DATABASE_URL=postgresql://postgres:postgres@prod-db:5432/canopyshield
CANPS_PRODUCTION_REDIS_URL=redis://prod-redis:6379/0
CANPS_PRODUCTION_JWT_ACCESS_SECRET=production-access-secret-min-16-chars-long
CANPS_PRODUCTION_JWT_REFRESH_SECRET=production-refresh-secret-min-16-chars-long
CANPS_PRODUCTION_OPENWEATHERMAP_API_KEY=your-production-api-key-here
CANPS_PRODUCTION_VAPID_SUBJECT=mailto:admin@canopyshield.io
CANPS_PRODUCTION_VAPID_PUBLIC_KEY=
CANPS_PRODUCTION_VAPID_PRIVATE_KEY=
CANPS_PRODUCTION_LOG_LEVEL=warn
CANPS_PRODUCTION_PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
CANPS_PRODUCTION_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
CANPS_PRODUCTION_TREE_PRICE=5000
